<%
const totpFaqs = [
  {
    question: 'Is my secret key stored?',
    answer: 'No. Your secret is only used to generate the current code and is <strong>never stored</strong> on our servers.',
  },
  {
    question: 'Should I use GET or POST?',
    answer: 'Both work. Prefer <code>POST</code> when calling the API — it keeps secrets out of URLs, server logs, and browser history.',
  },
  {
    question: 'What secret formats are supported?',
    answer: 'Base32 secrets (e.g. <code>JBSWY3DPEHPK3PXP</code>) and full <code>otpauth://</code> URIs. Spaces and dashes in secrets are stripped automatically.',
  },
  {
    question: 'Which authenticator apps work?',
    answer: 'Any standard TOTP app — Google Authenticator, Authy, 1Password, Microsoft Authenticator, and others.',
  },
  {
    question: 'Can I use this via API?',
    answer: 'Yes. Hit <code>/2fa</code> or <code>/totp</code> with your secret via GET query param or POST JSON body. The response includes the code and seconds until refresh.',
  },
];
%>

