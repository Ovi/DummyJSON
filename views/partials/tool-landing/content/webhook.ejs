const webhookFaqs = [
  {
    question: 'How long does a webhook stay active?',
    answer: 'Each webhook endpoint stays live for <strong>24 hours</strong>. Check the <code>x-expires-on</code> response header or the expiry badge in the inspector.',
  },
  {
    question: 'How many requests can I capture?',
    answer: 'Up to <strong>100 requests</strong> per webhook. When the limit is reached, the oldest requests are removed automatically.',
  },
  {
    question: 'Which HTTP methods are supported?',
    answer: 'All of them — <code>GET</code>, <code>POST</code>, <code>PUT</code>, <code>PATCH</code>, <code>DELETE</code>, <code>OPTIONS</code>, and more.',
  },
  {
    question: 'Is sensitive data stored?',
    answer: 'Headers like <code>authorization</code>, <code>cookie</code>, and <code>x-api-key</code> are stripped before storage. Maximum payload size is <strong>300 KB</strong>.',
  },
  {
    question: 'Can I use GET requests to my webhook URL?',
    answer: 'Yes. API clients and tools like <code>curl</code> capture requests normally. Opening the URL in a browser shows the interactive inspector instead.',
  },
];
%>

